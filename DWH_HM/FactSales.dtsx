            <component
              refId="Package\Fact Sales\Duplicados"
              componentClassID="Microsoft.Lookup"
              contactInfo="Lookup;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;6"
              description="Busca combinaciones repetidas de fecha, cliente y artículo; las coincidencias van a errores."
              name="Duplicados"
              usesDispositions="true"
              validateExternalMetadata="False"
              version="6">
              <properties>
                <property
                  dataType="System.String"
                  description="Specifies the SQL statement that generates the lookup table."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT Fecha,CustomerID,ArticleID
FROM (
    SELECT CASE WHEN LEN(LTRIM(RTRIM(t_dat)))=8 THEN TRY_CONVERT(DATE,t_dat,112)
                WHEN SUBSTRING(LTRIM(RTRIM(t_dat)),5,1)=N'-' THEN TRY_CONVERT(DATE,t_dat,23)
                ELSE TRY_CONVERT(DATE,t_dat,103) END AS Fecha,
        CONVERT(NVARCHAR(100),UPPER(LTRIM(RTRIM(customer_id)))) AS CustomerID,
        CONVERT(NVARCHAR(10),RIGHT(N'0000000000'+LTRIM(RTRIM(article_id)),10)) AS ArticleID
    FROM SALES.StageTransaction
    WHERE LEN(LTRIM(RTRIM(customer_id))) BETWEEN 1 AND 100
      AND LEN(LTRIM(RTRIM(article_id))) BETWEEN 1 AND 10
) S
WHERE Fecha IS NOT NULL
GROUP BY Fecha,CustomerID,ArticleID HAVING COUNT_BIG(*)&gt;1;</property>
                <property
                  dataType="System.String"
                  description="Specifies a SQL statement that uses parameters to generate the lookup table."
                  expressionType="Notify"
                  name="SqlCommandParam"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (SELECT Fecha,CustomerID,ArticleID
FROM (
    SELECT CASE WHEN LEN(LTRIM(RTRIM(t_dat)))=8 THEN TRY_CONVERT(DATE,t_dat,112)
                WHEN SUBSTRING(LTRIM(RTRIM(t_dat)),5,1)=N'-' THEN TRY_CONVERT(DATE,t_dat,23)
                ELSE TRY_CONVERT(DATE,t_dat,103) END AS Fecha,
        CONVERT(NVARCHAR(100),UPPER(LTRIM(RTRIM(customer_id)))) AS CustomerID,
        CONVERT(NVARCHAR(10),RIGHT(N'0000000000'+LTRIM(RTRIM(article_id)),10)) AS ArticleID
    FROM SALES.StageTransaction
    WHERE LEN(LTRIM(RTRIM(customer_id))) BETWEEN 1 AND 100
      AND LEN(LTRIM(RTRIM(article_id))) BETWEEN 1 AND 10
) S
WHERE Fecha IS NOT NULL
GROUP BY Fecha,CustomerID,ArticleID HAVING COUNT_BIG(*)&gt;1;) [refTable]
where [refTable].[Fecha] = ? and [refTable].[CustomerID] = ? and [refTable].[ArticleID] = ?</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the type of connection used to access the reference dataset."
                  name="ConnectionType"
                  typeConverter="LookupConnectionType">0</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the cache type of the lookup table."
                  name="CacheType"
                  typeConverter="CacheType">0</property>
                <property
                  dataType="System.Int32"
                  description="Specifies how the Lookup transformation handles rows without matching entries in the reference data set."
                  name="NoMatchBehavior"
                  typeConverter="LookupNoMatchBehavior">1</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the percentage of the cache that is allocated for rows with no matching entries in the reference dataset."
                  name="NoMatchCachePercentage">0</property>
                <property
                  dataType="System.Int32"
                  description="Maximum Memory Usage for Reference Cache on a 32 bit platform."
                  name="MaxMemoryUsage">25</property>
                <property
                  dataType="System.Int64"
                  description="Maximum Memory Usage for Reference Cache on a 64 bit platform."
                  name="MaxMemoryUsage64">1024</property>
                <property
                  dataType="System.String"
                  description="Indicates whether to reference metadata in an XML format."
                  name="ReferenceMetadataXml">&lt;referenceMetadata&gt;&lt;referenceColumns&gt;&lt;referenceColumn name="Fecha" dataType="DT_DBDATE" length="0" precision="0" scale="0" codePage="0"/&gt;&lt;referenceColumn name="CustomerID" dataType="DT_WSTR" length="100" precision="0" scale="0" codePage="0"/&gt;&lt;referenceColumn name="ArticleID" dataType="DT_WSTR" length="10" precision="0" scale="0" codePage="0"/&gt;&lt;/referenceColumns&gt;&lt;/referenceMetadata&gt;</property>
                <property
                  containsID="true"
                  dataType="System.String"
                  description="Specifies the list of lineage identifiers that map to the parameters that the SQL statement in the SQLCommand property uses. Entries in the list are separated by semicolons."
                  name="ParameterMap">#{Package\Fact Sales\Data Conversion.Outputs[Data Conversion Output].Columns[Fecha]};#{Package\Fact Sales\Data Conversion.Outputs[Data Conversion Output].Columns[CustomerID]};#{Package\Fact Sales\Data Conversion.Outputs[Data Conversion Output].Columns[ArticleID]};</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Determines whether duplicate keys in the reference data should be treated as errors when full cache mode is used."
                  name="TreatDuplicateKeysAsError">true</property>
              </properties>
              <connections>
                <connection
                  refId="Package\Fact Sales\Duplicados.Connections[OleDbConnection]"
                  connectionManagerID="{10F0C910-CA03-418B-BE05-9B1F106A1DF4}:external"
