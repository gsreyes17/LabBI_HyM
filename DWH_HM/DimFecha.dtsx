          SQLTask:Connection="{6A173C8B-30C1-4F61-B6EF-378748888835}"
          SQLTask:SqlStatementSource="UPDATE [DIM_AUDIT] &#xA;SET ExecStopDT = SYSDATETIME() &#xA;, ExtractRowCnt = (SELECT COUNT_BIG(*) FROM [STAGE_HM].GENERICO.StageDimFecha) &#xA;,TableFinalRowCnt = @RowCount &#xA;,SuccessfulProcessingInd='Y' &#xA;WHERE AuditKey = @AuditKey;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
