      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F933CBA-0D6B-4F5D-86BE-967AAD556B06}"
          SQLTask:SqlStatementSource="INSERT INTO [DIM_AUDIT] ([TableName], [PkgName], [PkgGUID], [ExecStartDT], [ExecStopDT], [ExecutionInstanceGUID], [ExtractRowCnt], [TableInitialRowCnt], [TableFinalRowCnt], [SuccessfulProcessingInd])&#xA;VALUES (@TableName, @PkgName, @PkgGUID, @StartTime, NULL, @PkgExecGUID, NULL, NULL, NULL, 'N')&#xA;SELECT CAST(SCOPE_IDENTITY() AS INT) AS AuditKey"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::AuditKey" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="StartTime"
            SQLTask:DtsVariableName="System::StartTime"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="26"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="PkgName"
            SQLTask:DtsVariableName="System::PackageName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="16"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="PkgGUID"
            SQLTask:DtsVariableName="System::PackageID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="9"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="PkgExecGUID"
            SQLTask:DtsVariableName="System::ExecutionInstanceGUID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="9"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="TableName"
            SQLTask:DtsVariableName="User::TableName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="16"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="RowCount"
            SQLTask:DtsVariableName="User::RowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="11"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
