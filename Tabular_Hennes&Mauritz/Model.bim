          {
            "type": "calculated",
            "name": "Orden_Edad",
            "dataType": "int64",
            "expression": "VAR E = DimCustomer[Age] RETURN SWITCH(TRUE(), ISBLANK(E) || E < 0, 7, E < 20, 1, E < 30, 2, E < 40, 3, E < 50, 4, E < 60, 5, 6)",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Tramo_Edad",
            "dataType": "string",
            "expression": "VAR E = DimCustomer[Age] RETURN SWITCH(TRUE(), ISBLANK(E) || E < 0, \"Sin datos\", E < 20, \"Menores de 20\", E < 30, \"20–29\", E < 40, \"30–39\", E < 50, \"40–49\", E < 60, \"50–59\", \"60 o más\")",
            "sortByColumn": "Orden_Edad",
            "summarizeBy": "none"
          }
        ],
