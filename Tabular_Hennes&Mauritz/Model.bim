      {
        "name": "Periodo_Base",
        "description": "Calendario independiente para elegir la ventana base. No contiene medidas ni modifica las tablas del DWH.",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Fecha",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Fecha]",
            "formatString": "dd/MM/yyyy",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Anio",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Anio]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Mes_Anio",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Mes_Anio]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Nombre_Mes",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Nombre_Mes]",
            "sortByColumn": "Mes_Anio",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Periodo",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Periodo]",
            "sortByColumn": "Periodo_Orden",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Periodo_Orden",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Periodo_Orden]",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Mes_Ordinal",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Mes_Ordinal]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Periodo_Base",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "SELECTCOLUMNS(FILTER(DimFecha, DimFecha[FechaKey] <> -1), \"Fecha\", DimFecha[Fecha], \"Anio\", DimFecha[Anio], \"Mes_Anio\", DimFecha[Mes_Anio], \"Nombre_Mes\", DimFecha[Nombre_Mes], \"Periodo\", DimFecha[Periodo], \"Periodo_Orden\", DimFecha[Periodo_Orden], \"Mes_Ordinal\", DimFecha[Mes_Ordinal])"
            }
          }
        ]
      }
    ],
