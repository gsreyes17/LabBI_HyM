{
  "name": "SemanticModel",
  "compatibilityLevel": 1700,
  "model": {
    "culture": "es-PE",
    "dataSources": [
      {
        "type": "structured",
        "name": "SQL/PC;DWH_HM",
        "connectionDetails": {
          "protocol": "tds",
          "address": {
            "server": "PC",
            "database": "DWH_HM"
          },
          "authentication": null,
          "query": null
        },
        "credential": {
          "AuthenticationKind": "ServiceAccount",
          "kind": "SQL",
          "path": "pc;DWH_HM",
          "EncryptConnection": false
        }
      }
    ],
    "tables": [
      {
        "name": "vw_DimCategory",
        "columns": [
          {
            "name": "CategoryID",
            "dataType": "int64",
            "sourceColumn": "CategoryID"
          },
          {
            "name": "DepartmentName",
            "dataType": "string",
            "sourceColumn": "DepartmentName"
          },
          {
            "name": "SectionName",
            "dataType": "string",
            "sourceColumn": "SectionName"
          },
          {
            "name": "Temporada",
            "dataType": "string",
            "sourceColumn": "Temporada"
          },
          {
            "name": "TemporadaID",
            "dataType": "int64",
            "sourceColumn": "TemporadaID"
          },
          {
            "type": "calculated",
            "name": "Nombre Temporada",
            "dataType": "string",
            "expression": "VAR T = LOWER(TRIM('vw_DimCategory'[Temporada]))\nRETURN SWITCH(TRUE(), CONTAINSSTRING(T,\"verano\"),\"Verano\", CONTAINSSTRING(T,\"otoño\"),\"Otoño\", CONTAINSSTRING(T,\"invierno\"),\"Invierno\", CONTAINSSTRING(T,\"primavera\"),\"Primavera\",\"Sin temporada\")",
            "sortByColumn": "Orden Temporada",
            "summarizeBy": "none",
            "isHidden": false,
            "description": "Estación sin sufijo de año. Conserva la asignación de temporada original; usar junto con el año del calendario."
          },
          {
            "type": "calculated",
            "name": "Orden Temporada",
            "dataType": "int64",
            "expression": "VAR T = LOWER(TRIM('vw_DimCategory'[Temporada])) RETURN SWITCH(TRUE(),CONTAINSSTRING(T,\"verano\"),1,CONTAINSSTRING(T,\"otoño\"),2,CONTAINSSTRING(T,\"invierno\"),3,CONTAINSSTRING(T,\"primavera\"),4,5)",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/PC;DWH_HM\",",
                "    Sales_vw_DimCategory = Source{[Schema=\"Sales\",Item=\"vw_DimCategory\"]}[Data]",
                "in",
                "    Sales_vw_DimCategory"
              ]
            }
          }
        ]
      },
      {
        "name": "vw_DimMonth",
        "columns": [
          {
            "name": "FechaKey",
            "dataType": "string",
            "sourceColumn": "FechaKey"
          },
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha"
          },
          {
            "name": "Nombre_Mes",
            "dataType": "string",
            "sourceColumn": "Nombre_Mes",
            "sortByColumn": "Mes_Anio"
          },
          {
            "name": "Mes_Anio",
            "dataType": "int64",
            "sourceColumn": "Mes_Anio"
          },
          {
            "name": "Anio",
            "dataType": "int64",
            "sourceColumn": "Anio"
          },
          {
            "type": "calculated",
            "name": "Periodo Mes",
            "dataType": "string",
            "description": "Año y mes para mostrar todo el historial sin mezclar meses de distintos años.",
            "expression": "FORMAT('vw_DimMonth'[Fecha], \"yyyy-MM\")",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/PC;DWH_HM\",",
                "    Sales_vw_DimMonth = Source{[Schema=\"Sales\",Item=\"vw_DimMonth\"]}[Data]",
                "in",
                "    Sales_vw_DimMonth"
              ]
            }
          }
        ]
      },
      {
        "name": "vw_FactSalesGoals",
        "columns": [
          {
            "name": "CategoryID",
            "dataType": "int64",
            "sourceColumn": "CategoryID"
          },
          {
            "name": "MontKey",
            "dataType": "string",
            "sourceColumn": "MontKey"
          },
          {
            "name": "Escenario",
            "dataType": "string",
            "sourceColumn": "Escenario"
          },
          {
            "name": "SubTotal",
            "dataType": "double",
            "sourceColumn": "SubTotal"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/PC;DWH_HM\",",
                "    Sales_vw_FactSalesGoals = Source{[Schema=\"Sales\",Item=\"vw_FactSalesGoals\"]}[Data]",
                "in",
                "    Sales_vw_FactSalesGoals"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": ".Sum_SubTotal_SalesGoals",
            "expression": " SUM(vw_FactSalesGoals[SubTotal])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Sum_SubTotal_Real",
            "expression": " SUM(vw_FactSalesMonthCategory[SubTotal])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".SubTotal_SalesGoals_Year",
            "expression": " TOTALYTD([.Sum_SubTotal_SalesGoals], vw_DimMonth[Fecha])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".SubTotal_SalesGoals_Yea-1r",
            "expression": " TOTALYTD([.Sum_SubTotal_SalesGoals], PREVIOUSYEAR(vw_DimMonth[Fecha]))",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".%var_SalesGoals",
            "expression": " DIVIDE([.SubTotal_SalesGoals_Year] - [.SubTotal_SalesGoals_Yea-1r], [.SubTotal_SalesGoals_Yea-1r], 0)",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".%Cumplimiento_Meta_Historica",
            "expression": " DIVIDE([.Sum_SubTotal_Real], [.Sum_SubTotal_SalesGoals], 0)",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".%Pareto_Categoria",
            "expression": [
              " ",
              "VAR A = [.Sum_SubTotal_SalesGoals]",
              "VAR B = ",
              "    CALCULATE(",
              "        [.Sum_SubTotal_SalesGoals],",
              "        ALLSELECTED(vw_DimCategory[DepartmentName])",
              "    )",
              "VAR TOTAL = ",
              "    DIVIDE(",
              "        SUMX(",
              "            FILTER(",
              "                SUMMARIZE(",
              "                    ALLSELECTED(vw_DimCategory[DepartmentName]),",
              "                    vw_DimCategory[DepartmentName],",
              "                    \"PORC\", [.Sum_SubTotal_SalesGoals]",
              "                ),",
              "                [PORC] >= A",
              "            ),",
              "            [PORC]",
              "        ),",
              "        B",
              "    )",
              "RETURN",
              "    TOTAL"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Ventas_Mensuales",
            "description": "Usar filtros de vw_DimMonth y vw_DimCategory. Escenario unico para metas. Sin moneda identificada; formato de importe con cuatro decimales.",
            "expression": "SUM(vw_FactSalesMonthCategory[SubTotal])",
            "formatString": "#,0.0000",
            "displayFolder": "01 Desempeno mensual",
            "isHidden": false
          },
          {
            "name": ".Meta_Seleccionada",
            "description": "Usar filtros de vw_DimMonth y vw_DimCategory. Escenario unico para metas. Sin moneda identificada; formato de importe con cuatro decimales.",
            "expression": "IF(HASONEVALUE(vw_FactSalesGoals[Escenario]), SUM(vw_FactSalesGoals[SubTotal]), BLANK())",
            "formatString": "#,0.0000",
            "displayFolder": "01 Desempeno mensual",
            "isHidden": false
          },
          {
            "name": ".%Cumplimiento_Meta",
            "description": "Usar filtros de vw_DimMonth y vw_DimCategory. Escenario unico para metas. ",
            "expression": "IF([.Meta_Seleccionada] > 0, DIVIDE([.Ventas_Mensuales], [.Meta_Seleccionada]), BLANK())",
            "formatString": "0.00%",
            "displayFolder": "01 Desempeno mensual",
            "isHidden": false
          },
          {
            "name": ".Brecha_Meta",
            "description": "Usar filtros de vw_DimMonth y vw_DimCategory. Escenario unico para metas. Sin moneda identificada; formato de importe con cuatro decimales.",
            "expression": "IF([.Meta_Seleccionada] > 0, COALESCE([.Ventas_Mensuales], 0) - [.Meta_Seleccionada], BLANK())",
            "formatString": "#,0.0000",
            "displayFolder": "01 Desempeno mensual",
            "isHidden": false
          },
          {
            "name": ".Deficit_Meta",
            "description": "Usar filtros de vw_DimMonth y vw_DimCategory. Escenario unico para metas. Sin moneda identificada; formato de importe con cuatro decimales.",
            "expression": "IF([.Meta_Seleccionada] > 0, MAX(0, [.Meta_Seleccionada] - COALESCE([.Ventas_Mensuales], 0)), BLANK())",
            "formatString": "#,0.0000",
            "displayFolder": "01 Desempeno mensual",
            "isHidden": false
          },
          {
            "name": ".Estado_Meta",
            "description": "Usar filtros de vw_DimMonth y vw_DimCategory. Escenario unico para metas. ",
            "expression": "IF(NOT HASONEVALUE(vw_FactSalesGoals[Escenario]), \"Seleccione un escenario\", IF(NOT([.Meta_Seleccionada] > 0), \"N/D\", IF([.%Cumplimiento_Meta] >= 1, \"Cumple\", \"Bajo meta\")))",
            "displayFolder": "01 Desempeno mensual",
            "isHidden": false
          },
          {
            "name": ".Ventas_Mensuales_Anteriores_Comparables",
            "description": "Variación interanual flexible: último año seleccionado frente a los mismos meses del año anterior. Incluye meses parciales y no exige cobertura completa. La etiqueta identifica coberturas parciales; solo la ausencia o cero de la base impide obtener una razón.",
            "expression": "VAR AnioFoco = MAXX(ALLSELECTED(vw_DimMonth),vw_DimMonth[Anio])\nVAR MesesActuales = FILTER(VALUES(vw_DimMonth[Fecha]),YEAR(vw_DimMonth[Fecha])=AnioFoco)\nVAR MesesAnteriores = SELECTCOLUMNS(MesesActuales,\"Fecha\",EDATE(vw_DimMonth[Fecha],-12))\nRETURN CALCULATE([.Ventas_Mensuales],REMOVEFILTERS(vw_DimMonth),TREATAS(MesesAnteriores,vw_DimMonth[Fecha]))",
            "formatString": "#,0.0000",
            "displayFolder": "02 Comparacion temporal",
            "isHidden": false
          },
          {
            "name": ".Cambio_Ventas_Mensuales_Comparable",
            "description": "Variación interanual flexible: último año seleccionado frente a los mismos meses del año anterior. Incluye meses parciales y no exige cobertura completa. La etiqueta identifica coberturas parciales; solo la ausencia o cero de la base impide obtener una razón.",
            "expression": "VAR Actual = [.Ventas_Mensuales_Actuales_Comparables]\nVAR Anterior = [.Ventas_Mensuales_Anteriores_Comparables]\nRETURN IF(NOT ISBLANK(Anterior),Actual-Anterior)",
            "formatString": "#,0.0000",
            "displayFolder": "02 Comparacion temporal",
            "isHidden": false
          },
          {
            "name": ".%Variacion_Ventas_Mensuales_Comparable",
            "description": "Variación interanual flexible: último año seleccionado frente a los mismos meses del año anterior. Incluye meses parciales y no exige cobertura completa. La etiqueta identifica coberturas parciales; solo la ausencia o cero de la base impide obtener una razón.",
            "expression": "DIVIDE([.Cambio_Ventas_Mensuales_Comparable],[.Ventas_Mensuales_Anteriores_Comparables])",
            "formatString": "0.00%",
            "displayFolder": "02 Comparacion temporal",
            "isHidden": false
          },
          {
            "name": ".Ventas_Mensuales_Actuales_Comparables",
            "isHidden": false,
            "displayFolder": "02 Comparacion temporal",
            "expression": "VAR AnioFoco = MAXX(ALLSELECTED(vw_DimMonth),vw_DimMonth[Anio])\nVAR MesesActuales = FILTER(VALUES(vw_DimMonth[Fecha]),YEAR(vw_DimMonth[Fecha])=AnioFoco)\nRETURN CALCULATE([.Ventas_Mensuales],REMOVEFILTERS(vw_DimMonth),TREATAS(MesesActuales,vw_DimMonth[Fecha]))",
            "description": "Variación interanual flexible: último año seleccionado frente a los mismos meses del año anterior. Incluye meses parciales y no exige cobertura completa. La etiqueta identifica coberturas parciales; solo la ausencia o cero de la base impide obtener una razón.",
            "formatString": "#,0.0000"
          },
          {
            "name": ".Lectura_Cambio_Interanual_Comparable",
            "isHidden": false,
            "displayFolder": "02 Comparacion temporal",
            "expression": "VAR Cambio = [.%Variacion_Ventas_Mensuales_Comparable]\nVAR Anterior = [.Ventas_Mensuales_Anteriores_Comparables]\nRETURN IF(NOT ISBLANK(Cambio),FORMAT(Cambio,\"+0.00%;-0.00%;0.00%\"),IF(ISBLANK(Anterior),\"Sin datos del año anterior\",\"Base anterior igual a cero\"))",
            "description": "Variación interanual flexible: último año seleccionado frente a los mismos meses del año anterior. Incluye meses parciales y no exige cobertura completa. La etiqueta identifica coberturas parciales; solo la ausencia o cero de la base impide obtener una razón."
          },
          {
            "name": ".Periodo_Comparacion_Interanual",
            "isHidden": false,
            "displayFolder": "02 Comparacion temporal",
            "expression": "VAR AnioFoco = MAXX(ALLSELECTED(vw_DimMonth),vw_DimMonth[Anio])\nVAR MesesActuales = FILTER(VALUES(vw_DimMonth[Fecha]),YEAR(vw_DimMonth[Fecha])=AnioFoco)\nVAR Cantidad = COUNTROWS(MesesActuales)\nVAR Desde = MINX(MesesActuales,vw_DimMonth[Fecha])\nVAR Hasta = MAXX(MesesActuales,vw_DimMonth[Fecha])\nVAR MesesTexto = IF(Cantidad=1,FORMAT(Desde,\"mmm\",\"en-US\"),IF(Cantidad=DATEDIFF(Desde,Hasta,MONTH)+1,FORMAT(Desde,\"mmm\",\"en-US\")&\"–\"&FORMAT(Hasta,\"mmm\",\"en-US\"),CONCATENATEX(MesesActuales,FORMAT(vw_DimMonth[Fecha],\"mmm\",\"en-US\"),\", \",vw_DimMonth[Fecha],ASC)))\nVAR MinKey = CALCULATE(MIN(FactSales[FechaKey]),REMOVEFILTERS(),FactSales[FechaKey]>0)\nVAR MaxKey = CALCULATE(MAX(FactSales[FechaKey]),REMOVEFILTERS(),FactSales[FechaKey]>0)\nVAR FechaMin = DATE(INT(MinKey/10000),INT(MOD(MinKey,10000)/100),MOD(MinKey,100))\nVAR FechaMax = DATE(INT(MaxKey/10000),INT(MOD(MaxKey,10000)/100),MOD(MaxKey,100))\nVAR Parcial = Desde<FechaMin || EOMONTH(Hasta,0)>FechaMax || EDATE(Desde,-12)<FechaMin || EOMONTH(EDATE(Hasta,-12),0)>FechaMax\nRETURN IF(Cantidad>0,FORMAT(AnioFoco,\"0\")&\" vs \"&FORMAT(AnioFoco-1,\"0\")&\" · \"&MesesTexto&IF(Parcial,\" · cobertura parcial\",\"\"),\"Sin periodo seleccionado\")",
            "description": "Variación interanual flexible: último año seleccionado frente a los mismos meses del año anterior. Incluye meses parciales y no exige cobertura completa. La etiqueta identifica coberturas parciales; solo la ausencia o cero de la base impide obtener una razón."
          }
        ]
      },
      {
