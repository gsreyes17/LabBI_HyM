      {
        "name": "DimFecha",
        "columns": [
          {
            "name": "FechaKey",
            "dataType": "int64",
            "sourceColumn": "FechaKey",
            "summarizeBy": "none"
          },
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha",
            "formatString": "dd/MM/yyyy",
            "summarizeBy": "none"
          },
          {
            "name": "Dia_Semana",
            "dataType": "int64",
            "sourceColumn": "Dia_Semana",
            "summarizeBy": "none"
          },
          {
            "name": "Nombre_Dia_Semana",
            "dataType": "string",
            "sourceColumn": "Nombre_Dia_Semana",
            "sortByColumn": "Dia_Semana",
            "summarizeBy": "none"
          },
          {
            "name": "Dia_Mes",
            "dataType": "int64",
            "sourceColumn": "Dia_Mes",
            "summarizeBy": "none"
          },
          {
            "name": "Dia_Anio",
            "dataType": "int64",
            "sourceColumn": "Dia_Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Nombre_Mes",
            "dataType": "string",
            "sourceColumn": "Nombre_Mes",
            "sortByColumn": "Mes_Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Mes_Anio",
            "dataType": "int64",
            "sourceColumn": "Mes_Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Semana_Anio",
            "dataType": "int64",
            "sourceColumn": "Semana_Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Anio",
            "dataType": "int64",
            "sourceColumn": "Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Bimestre",
            "dataType": "int64",
            "sourceColumn": "Bimestre",
            "summarizeBy": "none"
          },
          {
            "name": "Trimestre",
            "dataType": "int64",
            "sourceColumn": "Trimestre",
            "summarizeBy": "none"
          },
          {
            "name": "Cuatrimestre",
            "dataType": "int64",
            "sourceColumn": "Cuatrimestre",
            "summarizeBy": "none"
          },
          {
            "name": "Semestre",
            "dataType": "int64",
            "sourceColumn": "Semestre",
            "summarizeBy": "none"
          },
          {
            "name": "Fin_Semana",
            "dataType": "int64",
            "sourceColumn": "Fin_Semana",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Periodo_Orden",
            "dataType": "int64",
            "expression": "IF(DimFecha[FechaKey] = -1, -1, DimFecha[Anio] * 100 + DimFecha[Mes_Anio])",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Periodo",
            "dataType": "string",
            "expression": "IF(DimFecha[FechaKey] = -1, \"Sin fecha\", DimFecha[Nombre_Mes] & \" \" & FORMAT(DimFecha[Anio], \"0\"))",
            "sortByColumn": "Periodo_Orden",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Mes_Ordinal",
            "dataType": "int64",
            "expression": "IF(DimFecha[FechaKey] = -1, -1, DimFecha[Anio] * 12 + DimFecha[Mes_Anio])",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Semana_Orden",
            "dataType": "int64",
            "expression": "IF(DimFecha[FechaKey] = -1, -1, DimFecha[Anio] * 100 + DimFecha[Semana_Anio])",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Anio_Semana",
            "dataType": "string",
            "expression": "IF(DimFecha[FechaKey] = -1, \"Sin fecha\", FORMAT(DimFecha[Anio], \"0\") & \" / \" & FORMAT(DimFecha[Semana_Anio], \"00\"))",
            "sortByColumn": "Semana_Orden",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/ ;DWH_HM\",",
                "    GENERICO_DimFecha = Source{[Schema=\"GENERICO\",Item=\"DimFecha\"]}[Data]",
                "in",
                "    GENERICO_DimFecha"
              ]
            }
          }
        ]
      },
