            "sourceColumn": "SubTotal"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/PC;DWH_HM\",",
                "    Sales_vw_FactSalesMonthCategory = Source{[Schema=\"Sales\",Item=\"vw_FactSalesMonthCategory\"]}[Data]",
                "in",
                "    Sales_vw_FactSalesMonthCategory"
              ]
            }
          }
        ]
      },
      {
        "name": "FactSales",
        "columns": [
          {
            "name": "SaleID",
            "dataType": "int64",
            "sourceColumn": "SaleID"
          },
          {
            "name": "FechaKey",
            "dataType": "int64",
            "sourceColumn": "FechaKey"
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey"
          },
          {
            "name": "ArticleKey",
            "dataType": "int64",
            "sourceColumn": "ArticleKey"
          },
          {
            "name": "TemporadaKey",
            "dataType": "int64",
            "sourceColumn": "TemporadaKey"
          },
          {
            "name": "SalesChannelKey",
            "dataType": "int64",
            "sourceColumn": "SalesChannelKey"
          },
          {
            "name": "Price",
            "dataType": "double",
            "sourceColumn": "Price"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/PC;DWH_HM\",",
                "    Sales_FactSales = Source{[Schema=\"Sales\",Item=\"FactSales\"]}[Data]",
                "in",
                "    Sales_FactSales"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": ".Importe_Ventas",
            "description": "Usar dimensiones de detalle relacionadas con FactSales. Sin moneda identificada; formato de importe con cuatro decimales.",
            "expression": "SUM(FactSales[Price])",
            "formatString": "#,0.0000",
            "displayFolder": "01 Ventas y composicion",
            "isHidden": false
          },
          {
            "name": ".Registros_Venta",
            "description": "Usar dimensiones de detalle relacionadas con FactSales. ",
            "expression": "COUNTROWS(FactSales)",
            "formatString": "#,0",
            "displayFolder": "01 Ventas y composicion",
            "isHidden": false
          },
          {
            "name": ".Clientes_Compradores",
            "description": "Usar dimensiones de detalle relacionadas con FactSales. ",
            "expression": "CALCULATE(DISTINCTCOUNT(FactSales[CustomerKey]), KEEPFILTERS(FactSales[CustomerKey] <> -1))",
            "formatString": "#,0",
            "displayFolder": "01 Ventas y composicion",
            "isHidden": false
          },
          {
            "name": ".Importe_por_Registro",
            "description": "Usar dimensiones de detalle relacionadas con FactSales. Sin moneda identificada; formato de importe con cuatro decimales.",
            "expression": "DIVIDE([.Importe_Ventas], [.Registros_Venta])",
            "formatString": "#,0.0000",
            "displayFolder": "01 Ventas y composicion",
            "isHidden": false
          },
          {
            "name": ".Importe_por_Cliente",
            "description": "Usar dimensiones de detalle relacionadas con FactSales. Sin moneda identificada; formato de importe con cuatro decimales.",
            "expression": "DIVIDE(CALCULATE([.Importe_Ventas], KEEPFILTERS(FactSales[CustomerKey] <> -1)), [.Clientes_Compradores])",
            "formatString": "#,0.0000",
            "displayFolder": "01 Ventas y composicion",
            "isHidden": false
          },
          {
            "name": ".%Participacion_Canal",
            "description": "Usar dimensiones de detalle relacionadas con FactSales. ",
            "expression": "DIVIDE([.Importe_Ventas], CALCULATE([.Importe_Ventas], ALLSELECTED(DimSalesChannel[SalesChannelName])))",
            "formatString": "0.00%",
            "displayFolder": "01 Ventas y composicion",
            "isHidden": false
          },
          {
            "name": ".%Participacion_Grupo",
            "description": "Usar dimensiones de detalle relacionadas con FactSales. ",
            "expression": "DIVIDE([.Importe_Ventas], CALCULATE([.Importe_Ventas], ALLSELECTED(DimArticle[ProductGroupName])))",
            "formatString": "0.00%",
            "displayFolder": "01 Ventas y composicion",
            "isHidden": false
          },
          {
            "name": ".Sum_SubTotal",
            "expression": " SUM(FactSales[Price])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Avg_SubTotal",
            "expression": " AVERAGE(FactSales[Price])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Total_Transacciones",
            "expression": " COUNTROWS(FactSales)",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Clientes_Unicos",
            "expression": " DISTINCTCOUNT(FactSales[CustomerKey])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Titulo_Comparacion_anual",
            "expression": [
              " ",
              "CONCATENATE(\"Comparación Anual  \" & [.Anio_Actual], \" - \" & [.Anio_Actual] - 1 & \" - \" & [.Anio_Actual] - 2 & \" - \" & [.Anio_Actual] - 3)"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Titulo_Varianza",
            "expression": " CONCATENATE(\"Año \" & [.Anio_Actual], \" - \" & [.Anio_Actual] - 1)",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Titulo_Varianza1",
            "expression": " CONCATENATE(\"Año \" & [.Anio_Actual], \" - \" & [.Anio_Actual] - 2)",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".%Var_SubTotal_I",
            "expression": [
              " ",
              "VAR si = IF([.%var_SubTotal] < 0, \"▼\", \"▲\")",
              "RETURN CONCATENATE(ROUND([.%var_SubTotal], 4) * 100, \"%  \" & si)"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".SubTotal_Ultimos_Dias_7",
            "expression": [
              " ",
              "CALCULATE(",
              "    [.Sum_SubTotal],",
              "    DATESINPERIOD(DimFecha[Fecha], MAX(DimFecha[Fecha]) - 1, -7, DAY)",
              ")"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".SubTotal_Ultimos_Dias_7_avg",
            "expression": [
              " ",
              "CALCULATE(",
              "    [.Avg_SubTotal],",
              "    DATESINPERIOD(DimFecha[Fecha], MAX(DimFecha[Fecha]) - 1, -7, DAY)",
              ")"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".%Pareto_ProductGroup",
            "expression": [
              " ",
              "VAR A = [.Sum_SubTotal]",
              "VAR B = CALCULATE([.Sum_SubTotal], ALLSELECTED(DimArticle[ProductGroupName]))",
              "VAR TOTAL = ",
              "    DIVIDE(",
              "        SUMX(",
              "            FILTER(",
              "                SUMMARIZE(",
              "                    ALLSELECTED(DimArticle[ProductGroupName]),",
              "                    DimArticle[ProductGroupName],",
              "                    \"PORC\", [.Sum_SubTotal]",
              "                ),",
              "                [PORC] >= A",
              "            ),",
              "            [PORC]",
              "        ),",
              "        B",
              "    )",
              "RETURN TOTAL"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Subtotal_Anio_Actual",
            "expression": [
              " ",
              "VAR anio = [.Anio_Actual] ",
              "RETURN CALCULATE([.Sum_SubTotal], DimFecha[Anio] = anio)"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Subtotal_Anio_prev-1l",
            "expression": [
              " ",
              "VAR anio = [.Anio_Actual] - 1 ",
              "RETURN CALCULATE([.Sum_SubTotal], DimFecha[Anio] = anio)"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Subtotal_Anio_prev-2l",
            "expression": [
              " ",
              "VAR anio = [.Anio_Actual] - 2 ",
              "RETURN CALCULATE([.Sum_SubTotal], DimFecha[Anio] = anio)"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Subtotal_Anio_prev-3l",
            "expression": [
              " ",
              "VAR anio = [.Anio_Actual] - 3 ",
              "RETURN CALCULATE([.Sum_SubTotal], DimFecha[Anio] = anio)"
            ],
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".%var_SubTotal",
            "expression": " DIVIDE([.Subtotal_Anio_Actual] - [.Subtotal_Anio_prev-1l], [.Subtotal_Anio_prev-1l])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".%var_SubTotal1",
            "expression": " DIVIDE([.Subtotal_Anio_Actual] - [.Subtotal_Anio_prev-2l], [.Subtotal_Anio_prev-2l])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".%var_SubTotal2",
            "expression": " DIVIDE([.Subtotal_Anio_Actual] - [.Subtotal_Anio_prev-3l], [.Subtotal_Anio_prev-3l])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Acumulado_Anual",
            "expression": " TOTALYTD([.Sum_SubTotal], DimFecha[Fecha])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Anio_Actual",
            "expression": " MAX(DimFecha[Anio])",
            "displayFolder": "Historicas",
            "isHidden": false
          },
          {
            "name": ".Importe_Anterior_Comparable",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": [
              "VAR Inicio = MIN(DimFecha[Fecha])",
              "        VAR Fin = MAX(DimFecha[Fecha])",
              "        VAR InicioAnterior = EDATE(Inicio, -12)",
              "        VAR FinAnterior = EDATE(Fin, -12)",
              "        VAR InicioDisponible = CALCULATE(MIN(DimFecha[Fecha]), REMOVEFILTERS(DimFecha), DimFecha[FechaKey] <> -1)",
              "        VAR FinDisponible = CALCULATE(MAX(DimFecha[Fecha]), REMOVEFILTERS(DimFecha), DimFecha[FechaKey] <> -1)",
              "        VAR EsContinuo = COUNTROWS(VALUES(DimFecha[Fecha])) = DATEDIFF(Inicio, Fin, DAY) + 1",
              "        RETURN",
              "            IF(",
              "                HASONEVALUE(DimFecha[Anio]) && EsContinuo",
              "                    && InicioAnterior >= InicioDisponible && FinAnterior <= FinDisponible,",
              "                CALCULATE(",
              "                    [.Importe_Ventas],",
              "                    REMOVEFILTERS(DimFecha),",
              "                    DATESBETWEEN(DimFecha[Fecha], InicioAnterior, FinAnterior)",
              "                )",
              "            )"
            ],
            "formatString": "#,0.0000",
            "displayFolder": "02 Comparacion temporal",
            "isHidden": false
          },
          {
            "name": ".%Variacion_Importe_Comparable",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": "DIVIDE([.Importe_Ventas] - [.Importe_Anterior_Comparable], [.Importe_Anterior_Comparable])",
            "formatString": "0.00%",
            "displayFolder": "02 Comparacion temporal",
            "isHidden": false
          },
          {
            "name": ".Registros_Anteriores_Comparables",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": [
              "VAR Inicio = MIN(DimFecha[Fecha])",
              "        VAR Fin = MAX(DimFecha[Fecha])",
              "        VAR InicioAnterior = EDATE(Inicio, -12)",
              "        VAR FinAnterior = EDATE(Fin, -12)",
              "        VAR InicioDisponible = CALCULATE(MIN(DimFecha[Fecha]), REMOVEFILTERS(DimFecha), DimFecha[FechaKey] <> -1)",
              "        VAR FinDisponible = CALCULATE(MAX(DimFecha[Fecha]), REMOVEFILTERS(DimFecha), DimFecha[FechaKey] <> -1)",
              "        VAR EsContinuo = COUNTROWS(VALUES(DimFecha[Fecha])) = DATEDIFF(Inicio, Fin, DAY) + 1",
              "        RETURN",
              "            IF(",
              "                HASONEVALUE(DimFecha[Anio]) && EsContinuo",
              "                    && InicioAnterior >= InicioDisponible && FinAnterior <= FinDisponible,",
              "                CALCULATE(",
              "                    [.Registros_Venta],",
              "                    REMOVEFILTERS(DimFecha),",
              "                    DATESBETWEEN(DimFecha[Fecha], InicioAnterior, FinAnterior)",
              "                )",
              "            )"
            ],
            "formatString": "#,0",
            "displayFolder": "02 Comparacion temporal",
            "isHidden": false
          },
          {
            "name": ".%Variacion_Registros_Comparable",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": "DIVIDE([.Registros_Venta] - [.Registros_Anteriores_Comparables], [.Registros_Anteriores_Comparables])",
            "formatString": "0.00%",
            "displayFolder": "02 Comparacion temporal",
            "isHidden": false
          },
          {
            "name": ".Articulos_Vendidos",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": [
              "CALCULATE(",
              "            DISTINCTCOUNT(FactSales[ArticleKey]),",
              "            KEEPFILTERS(FactSales[ArticleKey] <> -1)",
              "        )"
            ],
            "formatString": "#,0",
            "displayFolder": "03 Productos",
            "isHidden": false
          },
          {
            "name": ".Dias_Cliente_Compra",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": [
              "COUNTROWS(",
              "            CALCULATETABLE(",
              "                SUMMARIZE(FactSales, FactSales[CustomerKey], FactSales[FechaKey]),",
              "                KEEPFILTERS(FactSales[CustomerKey] <> -1),",
              "                KEEPFILTERS(FactSales[FechaKey] <> -1)",
              "            )",
              "        )"
            ],
            "formatString": "#,0",
            "displayFolder": "02 Compradores y recurrencia",
            "isHidden": false
          },
          {
            "name": ".Dias_Compra_por_Comprador",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": "DIVIDE([.Dias_Cliente_Compra], [.Clientes_Compradores])",
            "formatString": "#,0.00",
            "displayFolder": "02 Compradores y recurrencia",
            "isHidden": false
          },
          {
            "name": ".Compradores_Recurrentes",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": [
              "VAR ClientesConDias =",
              "            CALCULATETABLE(",
              "                SUMMARIZE(",
              "                    FactSales,",
              "                    FactSales[CustomerKey],",
              "                    \"DiasCompra\", DISTINCTCOUNT(FactSales[FechaKey])",
              "                ),",
              "                KEEPFILTERS(FactSales[CustomerKey] <> -1),",
              "                KEEPFILTERS(FactSales[FechaKey] <> -1)",
              "            )",
              "        RETURN COUNTROWS(FILTER(ClientesConDias, [DiasCompra] >= 2))"
            ],
            "formatString": "#,0",
            "displayFolder": "02 Compradores y recurrencia",
            "isHidden": false
          },
          {
            "name": ".%Tasa_Recurrencia",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": "DIVIDE([.Compradores_Recurrentes], [.Clientes_Compradores])",
            "formatString": "0.00%",
            "displayFolder": "02 Compradores y recurrencia",
            "isHidden": false
          },
          {
            "name": ".%Participacion_Top_10_Articulos_Registros",
            "description": "Periodo y filtros seleccionados. Comparaciones sujetas a cobertura temporal; recurrencia requiere al menos dos fechas de compra distintas. Sin moneda acreditada: importes en UM.",
            "expression": [
              "VAR PorArticulo =",
              "            CALCULATETABLE(",
              "                SUMMARIZE(",
              "                    FactSales,",
              "                    FactSales[ArticleKey],",
              "                    \"RegistrosArticulo\", COUNTROWS(FactSales)",
              "                ),",
              "                KEEPFILTERS(FactSales[ArticleKey] <> -1)",
              "            )",
              "        VAR Principales = TOPN(10, PorArticulo, [RegistrosArticulo], DESC, FactSales[ArticleKey], ASC)",
              "        RETURN DIVIDE(SUMX(Principales, [RegistrosArticulo]), SUMX(PorArticulo, [RegistrosArticulo]))"
            ],
            "formatString": "0.00%",
            "displayFolder": "03 Productos",
            "isHidden": false
          }
        ]
      },
