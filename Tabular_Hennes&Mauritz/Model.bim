          },
          {
            "type": "calculated",
            "name": "Orden_Estacion",
            "dataType": "int64",
            "expression": "VAR T = LOWER(DimTemporada[Temporada]) RETURN SWITCH(TRUE(), CONTAINSSTRING(T, \"verano\"), 1, CONTAINSSTRING(T, \"otoño\") || CONTAINSSTRING(T, \"otono\"), 2, CONTAINSSTRING(T, \"invierno\"), 3, CONTAINSSTRING(T, \"primavera\"), 4, 5)",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Estacion",
            "dataType": "string",
            "expression": "VAR T = LOWER(DimTemporada[Temporada]) RETURN SWITCH(TRUE(), CONTAINSSTRING(T, \"verano\"), \"Verano\", CONTAINSSTRING(T, \"otoño\") || CONTAINSSTRING(T, \"otono\"), \"Otoño\", CONTAINSSTRING(T, \"invierno\"), \"Invierno\", CONTAINSSTRING(T, \"primavera\"), \"Primavera\", \"Sin datos\")",
            "sortByColumn": "Orden_Estacion",
            "summarizeBy": "none"
          }
        ],
