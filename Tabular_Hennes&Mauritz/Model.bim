{
  "name": "SemanticModel",
  "compatibilityLevel": 1700,
  "model": {
    "name": "Modelo",
    "culture": "es-PE",
    "dataSources": [
      {
        "type": "structured",
        "name": "SQL/ ;DWH_HM",
        "connectionDetails": {
          "protocol": "tds",
          "address": {
            "server": ".",
            "database": "DWH_HM"
          },
          "authentication": null,
          "query": null
        },
        "credential": {
          "AuthenticationKind": "ServiceAccount",
          "EncryptConnection": false
        }
      }
    ],
    "tables": [
      {
        "name": "vw_DimCategory",
        "columns": [
          {
            "name": "CategoryID",
            "dataType": "int64",
            "sourceColumn": "CategoryID",
            "summarizeBy": "none"
          },
          {
            "name": "DepartmentName",
            "dataType": "string",
            "sourceColumn": "DepartmentName",
            "summarizeBy": "none"
          },
          {
            "name": "SectionName",
            "dataType": "string",
            "sourceColumn": "SectionName",
            "summarizeBy": "none"
          },
          {
            "name": "Temporada",
            "dataType": "string",
            "sourceColumn": "Temporada",
            "summarizeBy": "none"
          },
          {
            "name": "TemporadaID",
            "dataType": "int64",
            "sourceColumn": "TemporadaID",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Orden_Estacion",
            "dataType": "int64",
            "expression": "VAR T = LOWER(vw_DimCategory[Temporada]) RETURN SWITCH(TRUE(), CONTAINSSTRING(T, \"verano\"), 1, CONTAINSSTRING(T, \"otoño\") || CONTAINSSTRING(T, \"otono\"), 2, CONTAINSSTRING(T, \"invierno\"), 3, CONTAINSSTRING(T, \"primavera\"), 4, 5)",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Estacion",
            "dataType": "string",
            "expression": "VAR T = LOWER(vw_DimCategory[Temporada]) RETURN SWITCH(TRUE(), CONTAINSSTRING(T, \"verano\"), \"Verano\", CONTAINSSTRING(T, \"otoño\") || CONTAINSSTRING(T, \"otono\"), \"Otoño\", CONTAINSSTRING(T, \"invierno\"), \"Invierno\", CONTAINSSTRING(T, \"primavera\"), \"Primavera\", \"Sin dato\")",
            "sortByColumn": "Orden_Estacion",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/ ;DWH_HM\",",
                "    Sales_vw_DimCategory = Source{[Schema=\"Sales\",Item=\"vw_DimCategory\"]}[Data]",
                "in",
                "    Sales_vw_DimCategory"
              ]
            }
          }
        ]
      },
      {
        "name": "vw_DimMonth",
        "columns": [
          {
            "name": "FechaKey",
            "dataType": "string",
            "sourceColumn": "FechaKey",
            "summarizeBy": "none"
          },
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha",
            "formatString": "dd/MM/yyyy",
            "summarizeBy": "none"
          },
          {
            "name": "Nombre_Mes",
            "dataType": "string",
            "sourceColumn": "Nombre_Mes",
            "sortByColumn": "Mes_Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Mes_Anio",
            "dataType": "int64",
            "sourceColumn": "Mes_Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Anio",
            "dataType": "int64",
            "sourceColumn": "Anio",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Periodo_Orden",
            "dataType": "int64",
            "expression": "IF(vw_DimMonth[FechaKey] = \"-1\", -1, vw_DimMonth[Anio] * 100 + vw_DimMonth[Mes_Anio])",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Periodo",
            "dataType": "string",
            "expression": "IF(vw_DimMonth[FechaKey] = \"-1\", \"Sin fecha\", vw_DimMonth[Nombre_Mes] & \" \" & FORMAT(vw_DimMonth[Anio], \"0\"))",
            "sortByColumn": "Periodo_Orden",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/ ;DWH_HM\",",
                "    Sales_vw_DimMonth = Source{[Schema=\"Sales\",Item=\"vw_DimMonth\"]}[Data]",
                "in",
                "    Sales_vw_DimMonth"
              ]
            }
          }
        ]
      },
      {
        "name": "vw_FactSalesGoals",
        "columns": [
          {
            "name": "CategoryID",
            "dataType": "int64",
            "sourceColumn": "CategoryID",
            "summarizeBy": "none"
          },
          {
            "name": "MontKey",
            "dataType": "string",
            "sourceColumn": "MontKey",
            "summarizeBy": "none"
          },
          {
            "name": "Escenario",
            "dataType": "string",
            "sourceColumn": "Escenario",
            "summarizeBy": "none"
          },
          {
            "name": "SubTotal",
            "dataType": "decimal",
            "sourceColumn": "SubTotal",
            "formatString": "#,0.00",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/ ;DWH_HM\",",
                "    Sales_vw_FactSalesGoals = Source{[Schema=\"Sales\",Item=\"vw_FactSalesGoals\"]}[Data]",
                "in",
                "    Sales_vw_FactSalesGoals"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": ".Escenario_Seleccionado",
            "description": "Escenario seleccionado",
            "expression": "IF(HASONEVALUE(vw_FactSalesGoals[Escenario]), SELECTEDVALUE(vw_FactSalesGoals[Escenario]), IF(NOT(ISFILTERED(vw_FactSalesGoals[Escenario])), MINX(ALL(vw_FactSalesGoals[Escenario]), vw_FactSalesGoals[Escenario])))",
            "formatString": "General",
            "displayFolder": "Apoyo_visual"
          },
          {
            "name": ".Meta_Ventas",
            "description": "3.16 · Meta de ventas",
            "expression": "VAR E = [.Escenario_Seleccionado] RETURN IF(NOT(ISBLANK(E)), CALCULATE(SUM(vw_FactSalesGoals[SubTotal]), KEEPFILTERS(vw_FactSalesGoals[Escenario] = E)))",
            "formatString": "#,0.00"
          },
          {
            "name": ".Ventas_Comparables_Meta",
            "description": "3.17 · Ventas comparables con la meta",
            "expression": [
              "VAR E = [.Escenario_Seleccionado]",
              "VAR Claves = CALCULATETABLE(SUMMARIZE(vw_FactSalesGoals, vw_FactSalesGoals[CategoryID], vw_FactSalesGoals[MontKey]), KEEPFILTERS(vw_FactSalesGoals[Escenario] = E))",
              "RETURN IF(NOT(ISBLANK(E)) && COUNTROWS(Claves) > 0,",
              " COALESCE(CALCULATE([.Ventas_Mensuales], KEEPFILTERS(TREATAS(Claves, vw_FactSalesMonthCategory[CategoryID], vw_FactSalesMonthCategory[MontKey]))), 0))"
            ],
            "formatString": "#,0.00"
          },
          {
            "name": ".%Cumplimiento_Meta",
            "description": "3.18 · Cumplimiento de la meta",
            "expression": "VAR M = [.Meta_Ventas] RETURN IF(NOT(ISBLANK(M)) && M > 0, DIVIDE([.Ventas_Comparables_Meta], M))",
            "formatString": "0.0%"
          },
          {
            "name": ".Brecha_Meta",
            "description": "3.19 · Brecha frente a meta",
            "expression": "VAR M = [.Meta_Ventas] RETURN IF(NOT(ISBLANK(M)), [.Ventas_Comparables_Meta] - M)",
            "formatString": "+#,0.00;-#,0.00;0.00"
          },
          {
            "name": ".%Cobertura_Metas",
            "description": "3.20 · Cobertura de metas",
            "expression": "IF(NOT(ISBLANK([.Escenario_Seleccionado])), DIVIDE(COALESCE([.Ventas_Comparables_Meta], 0), [.Ventas_Mensuales]))",
            "formatString": "0.0%"
          },
          {
            "name": ".KPI_Meta_Ventas",
            "description": "Meta de ventas",
            "expression": "VAR V = [.Meta_Ventas] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0.00\"))",
            "formatString": "General",
            "displayFolder": "Apoyo_visual"
          },
          {
            "name": ".KPI_Ventas_Comparables_Meta",
            "description": "Ventas comparables con la meta",
            "expression": "VAR V = [.Ventas_Comparables_Meta] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0.00\"))",
            "formatString": "General",
            "displayFolder": "Apoyo_visual"
          },
          {
            "name": ".KPI_Cumplimiento_Meta",
            "description": "Cumplimiento de la meta",
            "expression": "VAR V = [.%Cumplimiento_Meta] VAR M = [.Meta_Ventas] RETURN IF(ISBLANK(M), \"Sin meta\", IF(M = 0, \"Sin base\", FORMAT(V, \"0.0%\")))",
            "formatString": "General",
            "displayFolder": "Apoyo_visual"
          },
          {
            "name": ".KPI_Brecha_Meta",
            "description": "Brecha frente a meta",
            "expression": "VAR V = [.Brecha_Meta] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0.00\"))",
            "formatString": "General",
            "displayFolder": "Apoyo_visual"
          },
          {
            "name": ".KPI_Cobertura_Metas",
            "description": "Cobertura de metas",
            "expression": "VAR V = [.%Cobertura_Metas] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"0.0%\"))",
            "formatString": "General",
            "displayFolder": "Apoyo_visual"
          },
          {
            "name": ".Color_Brecha_Meta",
            "description": "Apoyo de formato: rojo para brecha negativa y verde para positiva.",
            "expression": "VAR B = [.Brecha_Meta] RETURN IF(ISBLANK(B), \"#FFFFFF\", IF(B < 0, \"#F4A2B0\", IF(B > 0, \"#A2D8BC\", \"#FFFFFF\")))",
            "formatString": "General",
            "displayFolder": "Apoyo_visual"
          }
        ]
      },
      {
        "name": "vw_FactSalesMonthCategory",
        "columns": [
          {
            "name": "CategoryID",
            "dataType": "int64",
            "sourceColumn": "CategoryID",
            "summarizeBy": "none"
          },
          {
            "name": "MontKey",
            "dataType": "string",
            "sourceColumn": "MontKey",
            "summarizeBy": "none"
          },
          {
            "name": "SubTotal",
            "dataType": "decimal",
            "sourceColumn": "SubTotal",
            "formatString": "#,0.00",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/ ;DWH_HM\",",
                "    Sales_vw_FactSalesMonthCategory = Source{[Schema=\"Sales\",Item=\"vw_FactSalesMonthCategory\"]}[Data]",
                "in",
                "    Sales_vw_FactSalesMonthCategory"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": ".Ventas_Mensuales",
            "description": "Ventas mensuales",
            "expression": "SUM(vw_FactSalesMonthCategory[SubTotal])",
            "formatString": "#,0.00",
            "displayFolder": "Apoyo_visual"
          }
        ]
      },
      {
        "name": "FactSales",
        "columns": [
          {
            "name": "FechaKey",
            "dataType": "int64",
            "sourceColumn": "FechaKey",
            "summarizeBy": "none"
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "summarizeBy": "none"
          },
          {
            "name": "ArticleKey",
            "dataType": "int64",
            "sourceColumn": "ArticleKey",
            "summarizeBy": "none"
          },
          {
            "name": "TemporadaKey",
            "dataType": "int64",
            "sourceColumn": "TemporadaKey",
            "summarizeBy": "none"
          },
          {
            "name": "SalesChannelKey",
            "dataType": "int64",
            "sourceColumn": "SalesChannelKey",
            "summarizeBy": "none"
          },
          {
            "name": "Price",
            "dataType": "decimal",
            "sourceColumn": "Price",
            "formatString": "#,0.00",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/ ;DWH_HM\",",
                "    Sales_FactSales = Source{[Schema=\"Sales\",Item=\"FactSales\"]}[Data]",
                "in",
                "    Sales_FactSales"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": ".Importe_Ventas",
            "description": "3.1 · Importe de ventas",
            "expression": "SUM(FactSales[Price])",
            "formatString": "#,0.00"
          },
          {
            "name": ".Registros_Venta",
            "description": "3.2 · Registros de venta",
            "expression": "COUNTROWS(FactSales)",
            "formatString": "#,0"
          },
          {
            "name": ".Compradores_Identificados",
            "description": "3.3 · Compradores identificados",
            "expression": "CALCULATE(DISTINCTCOUNT(FactSales[CustomerKey]), KEEPFILTERS(FactSales[CustomerKey] <> -1))",
            "formatString": "#,0"
          },
          {
            "name": ".Articulos_Con_Venta",
            "description": "3.4 · Artículos con venta",
            "expression": "CALCULATE(DISTINCTCOUNT(FactSales[ArticleKey]), KEEPFILTERS(FactSales[ArticleKey] <> -1))",
            "formatString": "#,0"
          },
          {
            "name": ".Importe_Por_Registro",
            "description": "3.5 · Importe por registro",
            "expression": "DIVIDE([.Importe_Ventas], [.Registros_Venta])",
            "formatString": "#,0.00"
          },
          {
            "name": ".Importe_Por_Comprador",
            "description": "3.6 · Importe por comprador",
            "expression": "DIVIDE([.Importe_Ventas], [.Compradores_Identificados])",
            "formatString": "#,0.00"
          },
          {
            "name": ".Registros_Por_Comprador",
            "description": "3.7 · Registros por comprador",
            "expression": "DIVIDE([.Registros_Venta], [.Compradores_Identificados])",
            "formatString": "#,0.00"
          },
          {
            "name": ".Compradores_Recurrentes",
            "description": "A1 · Compradores recurrentes",
            "expression": [
              "VAR C = CALCULATETABLE(",
              " SUMMARIZECOLUMNS(FactSales[CustomerKey], \"_Primera\", MIN(FactSales[FechaKey]), \"_Ultima\", MAX(FactSales[FechaKey])),",
              " KEEPFILTERS(FactSales[CustomerKey] <> -1), KEEPFILTERS(FactSales[FechaKey] <> -1))",
              "RETURN IF([.Compradores_Identificados] > 0, COALESCE(COUNTROWS(FILTER(C, [_Primera] <> [_Ultima])), 0))"
            ],
            "formatString": "#,0"
          },
          {
            "name": ".Dias_Compra_Por_Comprador",
            "description": "A2 · Días de compra por comprador",
            "expression": "DIVIDE(COUNTROWS(SUMMARIZE(FactSales, FactSales[CustomerKey], FactSales[FechaKey])), [.Compradores_Identificados])",
            "formatString": "#,0.00"
          },
          {
            "name": ".%Recurrencia_Compra",
            "description": "3.8 · Recurrencia de compra",
            "expression": "DIVIDE([.Compradores_Recurrentes], [.Compradores_Identificados])",
            "formatString": "0.0%"
          },
          {
            "name": ".%Participacion_Ventas",
            "description": "3.9 · Participación de ventas",
            "expression": [
              "VAR TotalGrupo = SWITCH(TRUE(),",
              " ISINSCOPE(DimSalesChannel[SalesChannelName]), CALCULATE([.Importe_Ventas], ALLSELECTED(DimSalesChannel[SalesChannelName])),",
              " ISINSCOPE(DimCustomer[ClubMemberStatus]), CALCULATE([.Importe_Ventas], ALLSELECTED(DimCustomer[ClubMemberStatus])),",
              " ISINSCOPE(DimArticle[ProductGroupName]), CALCULATE([.Importe_Ventas], ALLSELECTED(DimArticle[ProductGroupName])),",
              " CALCULATE([.Importe_Ventas], ALLSELECTED()))",
              "RETURN DIVIDE([.Importe_Ventas], TotalGrupo)"
            ],
            "formatString": "0.0%"
          },
          {
            "name": ".%Top_10_Registros",
            "description": "3.10 · Participación Top 10 en registros",
            "expression": [
              "VAR A = FILTER(ADDCOLUMNS(ALLSELECTED(DimArticle[ArticleKey]), \"_Registros\", CALCULATE([.Registros_Venta])), DimArticle[ArticleKey] <> -1 && [_Registros] > 0)",
              "VAR T = TOPN(10, A, [_Registros], DESC, DimArticle[ArticleKey], ASC)",
              "RETURN DIVIDE(SUMX(T, [_Registros]), [.Registros_Venta])"
            ],
            "formatString": "0.0%"
          },
          {
            "name": ".Articulos_Catalogo",
            "description": "3.11 · Artículos del catálogo",
            "expression": "CALCULATE(DISTINCTCOUNT(DimArticle[ArticleKey]), KEEPFILTERS(DimArticle[ArticleKey] <> -1))",
            "formatString": "#,0"
          },
          {
            "name": ".%Cobertura_Catalogo",
            "description": "3.12 · Cobertura comercial del catálogo",
            "expression": "DIVIDE([.Articulos_Con_Venta], [.Articulos_Catalogo])",
            "formatString": "0.0%"
          },
          {
            "name": ".Dias_Con_Actividad",
            "description": "A3 · Días con actividad",
            "expression": "CALCULATE(DISTINCTCOUNT(FactSales[FechaKey]), KEEPFILTERS(FactSales[FechaKey] <> -1))",
            "formatString": "#,0"
          },
          {
            "name": ".Venta_Por_Dia_Activo",
            "description": "3.13 · Venta por día con actividad",
            "expression": "DIVIDE([.Importe_Ventas], [.Dias_Con_Actividad])",
            "formatString": "#,0.00"
          },
          {
            "name": ".Importe_Periodo_Base",
            "description": "A4 · Importe del periodo base",
            "expression": [
              "VAR TieneBase = ISCROSSFILTERED(Periodo_Base)",
              "VAR InicioA = MINX(FILTER(ALLSELECTED(DimFecha), DimFecha[FechaKey] <> -1), DimFecha[Fecha])",
              "VAR InicioB = MINX(ALLSELECTED(Periodo_Base), Periodo_Base[Fecha])",
              "VAR OrdA = YEAR(InicioA) * 12 + MONTH(InicioA)",
              "VAR OrdB = YEAR(InicioB) * 12 + MONTH(InicioB)",
              "VAR EjeMensual = ISINSCOPE(DimFecha[Periodo]) || ISINSCOPE(DimFecha[Periodo_Orden]) || ISINSCOPE(DimFecha[Nombre_Mes])",
              "VAR Posiciones = SELECTCOLUMNS(VALUES(DimFecha[Mes_Ordinal]), \"_Pos\", DimFecha[Mes_Ordinal] - OrdA)",
              "VAR FechasElegidas = SELECTCOLUMNS(FILTER(Periodo_Base, NOT(EjeMensual) || Periodo_Base[Mes_Ordinal] - OrdB IN Posiciones), \"_Fecha\", Periodo_Base[Fecha])",
              "VAR FechasAutomaticas = SELECTCOLUMNS(FILTER(VALUES(DimFecha[Fecha]), NOT(ISBLANK(DimFecha[Fecha]))), \"_Fecha\", EDATE(DimFecha[Fecha], -12))",
              "VAR FechasB = UNION(FILTER(FechasElegidas, TieneBase), FILTER(FechasAutomaticas, NOT(TieneBase)))",
              "VAR EstacionesB = VALUES(vw_DimCategory[TemporadaID])",
              "RETURN CALCULATE([.Importe_Ventas], REMOVEFILTERS(DimFecha), TREATAS(FechasB, DimFecha[Fecha]), REMOVEFILTERS(DimTemporada), TREATAS(EstacionesB, DimTemporada[TemporadaID]))"
            ],
            "formatString": "#,0.00"
          },
          {
            "name": ".Registros_Periodo_Base",
            "description": "A5 · Registros del periodo base",
            "expression": [
              "VAR TieneBase = ISCROSSFILTERED(Periodo_Base)",
              "VAR InicioA = MINX(FILTER(ALLSELECTED(DimFecha), DimFecha[FechaKey] <> -1), DimFecha[Fecha])",
              "VAR InicioB = MINX(ALLSELECTED(Periodo_Base), Periodo_Base[Fecha])",
              "VAR OrdA = YEAR(InicioA) * 12 + MONTH(InicioA)",
              "VAR OrdB = YEAR(InicioB) * 12 + MONTH(InicioB)",
              "VAR EjeMensual = ISINSCOPE(DimFecha[Periodo]) || ISINSCOPE(DimFecha[Periodo_Orden]) || ISINSCOPE(DimFecha[Nombre_Mes])",
              "VAR Posiciones = SELECTCOLUMNS(VALUES(DimFecha[Mes_Ordinal]), \"_Pos\", DimFecha[Mes_Ordinal] - OrdA)",
              "VAR FechasElegidas = SELECTCOLUMNS(FILTER(Periodo_Base, NOT(EjeMensual) || Periodo_Base[Mes_Ordinal] - OrdB IN Posiciones), \"_Fecha\", Periodo_Base[Fecha])",
              "VAR FechasAutomaticas = SELECTCOLUMNS(FILTER(VALUES(DimFecha[Fecha]), NOT(ISBLANK(DimFecha[Fecha]))), \"_Fecha\", EDATE(DimFecha[Fecha], -12))",
              "VAR FechasB = UNION(FILTER(FechasElegidas, TieneBase), FILTER(FechasAutomaticas, NOT(TieneBase)))",
              "VAR EstacionesB = VALUES(vw_DimCategory[TemporadaID])",
              "RETURN CALCULATE([.Registros_Venta], REMOVEFILTERS(DimFecha), TREATAS(FechasB, DimFecha[Fecha]), REMOVEFILTERS(DimTemporada), TREATAS(EstacionesB, DimTemporada[TemporadaID]))"
            ],
            "formatString": "#,0"
          },
          {
            "name": ".Dias_Base",
            "description": "Días de actividad de la base",
            "expression": [
              "VAR TieneBase = ISCROSSFILTERED(Periodo_Base)",
              "VAR InicioA = MINX(FILTER(ALLSELECTED(DimFecha), DimFecha[FechaKey] <> -1), DimFecha[Fecha])",
              "VAR InicioB = MINX(ALLSELECTED(Periodo_Base), Periodo_Base[Fecha])",
              "VAR OrdA = YEAR(InicioA) * 12 + MONTH(InicioA)",
              "VAR OrdB = YEAR(InicioB) * 12 + MONTH(InicioB)",
              "VAR EjeMensual = ISINSCOPE(DimFecha[Periodo]) || ISINSCOPE(DimFecha[Periodo_Orden]) || ISINSCOPE(DimFecha[Nombre_Mes])",
              "VAR Posiciones = SELECTCOLUMNS(VALUES(DimFecha[Mes_Ordinal]), \"_Pos\", DimFecha[Mes_Ordinal] - OrdA)",
              "VAR FechasElegidas = SELECTCOLUMNS(FILTER(Periodo_Base, NOT(EjeMensual) || Periodo_Base[Mes_Ordinal] - OrdB IN Posiciones), \"_Fecha\", Periodo_Base[Fecha])",
              "VAR FechasAutomaticas = SELECTCOLUMNS(FILTER(VALUES(DimFecha[Fecha]), NOT(ISBLANK(DimFecha[Fecha]))), \"_Fecha\", EDATE(DimFecha[Fecha], -12))",
              "VAR FechasB = UNION(FILTER(FechasElegidas, TieneBase), FILTER(FechasAutomaticas, NOT(TieneBase)))",
              "VAR EstacionesB = VALUES(vw_DimCategory[TemporadaID])",
              "RETURN CALCULATE([.Dias_Con_Actividad], REMOVEFILTERS(DimFecha), TREATAS(FechasB, DimFecha[Fecha]), REMOVEFILTERS(DimTemporada), TREATAS(EstacionesB, DimTemporada[TemporadaID]))"
            ],
            "formatString": "#,0",
            "displayFolder": "Apoyo_visual"
          },
          {
            "name": ".%Variacion_Ventas",
            "description": "3.14 · Variación de ventas entre periodos",
            "expression": "VAR B = [.Importe_Periodo_Base] RETURN IF(NOT(ISBLANK([.Importe_Ventas])) && NOT(ISBLANK(B)) && B <> 0, DIVIDE([.Importe_Ventas] - B, B))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": ".%Variacion_Registros",
            "description": "3.15 · Variación de registros entre periodos",
            "expression": "VAR B = [.Registros_Periodo_Base] RETURN IF(NOT(ISBLANK([.Registros_Venta])) && NOT(ISBLANK(B)) && B <> 0, DIVIDE([.Registros_Venta] - B, B))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": ".KPI_Importe_Ventas",
            "description": "Importe de ventas",
            "expression": "VAR V = [.Importe_Ventas] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0.00\"))",
            "formatString": "General",
            "displayFolder": "Apoyo_visual"
          },
          {
            "name": ".KPI_Registros_Venta",
            "description": "Registros de venta",
            "expression": "VAR V = [.Registros_Venta] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0\"))",
            "formatString": "General",
            "displayFolder": "Apoyo_visual"
          },
