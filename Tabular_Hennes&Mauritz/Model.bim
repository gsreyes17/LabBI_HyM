          {
            "type": "calculated",
            "name": "Nombre Temporada",
            "dataType": "string",
            "expression": "VAR T = LOWER(TRIM('DimTemporada'[Temporada]))\nRETURN SWITCH(TRUE(), CONTAINSSTRING(T,\"verano\"),\"Verano\", CONTAINSSTRING(T,\"otoño\"),\"Otoño\", CONTAINSSTRING(T,\"invierno\"),\"Invierno\", CONTAINSSTRING(T,\"primavera\"),\"Primavera\",\"Sin temporada\")",
            "sortByColumn": "Orden Temporada",
            "summarizeBy": "none",
            "isHidden": false,
            "description": "Estación sin sufijo de año. Conserva la asignación de temporada original; usar junto con el año del calendario."
          },
          {
            "type": "calculated",
            "name": "Orden Temporada",
            "dataType": "int64",
            "expression": "VAR T = LOWER(TRIM('DimTemporada'[Temporada])) RETURN SWITCH(TRUE(),CONTAINSSTRING(T,\"verano\"),1,CONTAINSSTRING(T,\"otoño\"),2,CONTAINSSTRING(T,\"invierno\"),3,CONTAINSSTRING(T,\"primavera\"),4,5)",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
