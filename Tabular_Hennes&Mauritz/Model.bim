            "type": "calculated",
            "name": "Tramo Edad",
            "dataType": "string",
            "description": "Edad registrada en el archivo; no representa edad historica a la fecha de cada compra.",
            "expression": "VAR Edad = DimCustomer[Age] RETURN SWITCH(TRUE(), ISBLANK(Edad) || Edad < 0, \"Sin dato\", Edad < 20, \"Menores de 20\", Edad < 30, \"20-29\", Edad < 40, \"30-39\", Edad < 50, \"40-49\", Edad < 60, \"50-59\", \"60 o mas\")",
            "sortByColumn": "Orden Tramo Edad",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Orden Tramo Edad",
            "dataType": "int64",
            "expression": "VAR Edad = DimCustomer[Age] RETURN SWITCH(TRUE(), ISBLANK(Edad) || Edad < 0, 7, Edad < 20, 1, Edad < 30, 2, Edad < 40, 3, Edad < 50, 4, Edad < 60, 5, 6)",
            "summarizeBy": "none"
          }
        ],
